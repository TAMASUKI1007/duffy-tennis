# ---- 経路API（NAVITIME via RapidAPI）----
# RapidAPI のアカウントで navitime-route-totalnavi を購読して取得したキー
RAPIDAPI_KEY=
RAPIDAPI_HOST=navitime-route-totalnavi.p.rapidapi.com

# ---- 以下は第2段階の実装で使用（現時点では未使用）----
# Supabase（サーバー側からのみ使用。ブラウザには出さない）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Googleカレンダー（サービスアカウント。カレンダーは「予定の表示（空き時間情報のみ）」で共有）
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_IDS=

# LINE公式アカウントID（@から始まるID。@は含めない形式かは実機確認後に確定）
LINE_OA_ID=
